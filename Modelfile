FROM ornith:35b

# Set the context window size to 16k tokens
PARAMETER num_ctx 196000
# Hard cap runaway responses.
PARAMETER num_predict 4096

# Stable coding/chat sampling.
# PARAMETER temperature 0.25
# PARAMETER top_p 0.90
# PARAMETER top_k 64

# Mild anti-repetition, but look back farther than the Ollama default.
# PARAMETER repeat_penalty 1.15
# PARAMETER repeat_last_n 1024

SYSTEM """
You are a concise coding assistant. Do not repeat previous text.
Do not output hidden reasoning or thought blocks. Stop after giving the answer or patch.
"""