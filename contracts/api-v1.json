{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "edatime HTTP API contract",
  "version": "v1",
  "basePath": "/api/v1",
  "headers": {
    "requestId": "x-request-id",
    "requestIdCallerPolicy": "A caller-supplied ID is accepted only when it is 1-128 ASCII letters, digits, dot, underscore, or hyphen; otherwise the server replaces it.",
    "buildVersion": "x-edatime-build",
    "buildCommit": "x-edatime-build-sha",
    "buildProfile": "x-edatime-build-profile",
    "contractVersion": "x-edatime-contract"
  },
  "error": {
    "contentType": "application/json",
    "required": ["error", "message", "kind", "code", "correlation_id", "request_id"]
  },
  "operations": [
    {"method":"GET","path":"/api/v1/health","response":"HealthResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/build","response":"BuildIdentity","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/contract","response":"ApiContract","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/capabilities","response":"Capabilities","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/data","request":"DataRequest","response":"ArrowData|JsonData","contentType":"application/vnd.apache.arrow.stream|application/json","planAware":true},
    {"method":"POST","path":"/api/v1/cleaning/validate","request":"CleaningPlanEnvelope","response":"ValidationResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/preview","request":"CleaningPreviewRequest","response":"CleaningPreviewResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/propose/outliers","request":"OutlierProposalRequest","response":"OutlierProposalResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/apply","request":"CleaningApplyRequest","response":"CleaningApplyResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/export/data","request":"CleaningExportRequest","response":"File","contentType":"application/octet-stream"},
    {"method":"POST","path":"/api/v1/cleaning/export/plan","request":"CleaningExportRequest","response":"File","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/export/code","request":"CleaningExportRequest","response":"File","contentType":"text/plain"},
    {"method":"POST","path":"/api/v1/cleaning/export/manifest","request":"CleaningExportRequest","response":"File","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/export/bundle","request":"CleaningExportRequest","response":"File","contentType":"application/zip"},
    {"method":"GET","path":"/api/v1/datasets/versions","response":"DatasetVersionsResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/datasets/versions/select","request":"SelectVersionRequest","response":"SelectVersionResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/datasets/storage","response":"StorageUsageResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/metadata","response":"DatasetMetadata","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/profile","response":"ProfileResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/profile","response":"ProfileResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/profile/sample","response":"ProfileResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/profile/sample","response":"ProfileResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/metrics","response":"MetricsResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/metrics/prometheus","response":"PrometheusMetrics","contentType":"text/plain"},
    {"method":"GET","path":"/api/v1/jobs","response":"JobListResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/jobs/{id}","response":"JobResponse","contentType":"application/json"},
    {"method":"DELETE","path":"/api/v1/jobs/{id}","response":"JobResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/scatter/points","request":"ScatterPointsRequest","response":"ScatterPointsResponse|ArrowData","contentType":"application/json|application/vnd.apache.arrow.stream","planAware":true},
    {"method":"POST","path":"/api/v1/scatter/matrix","request":"ScatterMatrixRequest","response":"ScatterMatrixResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/scatter/export/parquet","request":"ScatterExportRequest","response":"File","contentType":"application/vnd.apache.parquet","planAware":true},
    {"method":"POST","path":"/api/v1/scatter/correlations","request":"ScatterCorrelationsRequest","response":"ScatterCorrelationsResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/scatter/correlations/matrix","request":"CorrelationMatrixRequest","response":"CorrelationMatrixResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/upload","request":"MultipartUpload","response":"UploadResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/upload/preview","request":"MultipartUpload","response":"UploadPreviewResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/sample/{name}","response":"File","contentType":"text/csv"},
    {"method":"POST","path":"/api/v1/database/connect","request":"DatabaseConnectRequest","response":"DatabaseStatusResponse","contentType":"application/json"},
    {"method":"DELETE","path":"/api/v1/database/connect","response":"DatabaseStatusResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/database/status","response":"DatabaseStatusResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/database/tables","response":"DatabaseTablesResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/database/columns","response":"DatabaseColumnsResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/database/load","request":"DatabaseLoadRequest","response":"UploadResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/config/database","response":"DatabaseConfigResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/aggregate","request":"AggregateQuery","response":"AggregateResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/analytics/rolling","request":"RollingRequest","response":"RollingResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/analytics/anomalies","request":"AnomalyRequest","response":"AnomalyResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/analytics/fft","request":"FftRequest","response":"FftResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/analytics/spectrogram","request":"SpectrogramRequest","response":"SpectrogramResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/analytics/spectral-filter","request":"SpectralFilterRequest","response":"SpectralFilterResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/analytics/causal","request":"CausalGraphRequest","response":"CausalGraphResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/drift/stats","request":"DriftStatsRequest","response":"DriftStatsResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/drift/investigate","request":"DriftInvestigateRequest","response":"DriftInvestigateResponse","contentType":"application/json","planAware":true}
  ]
}
