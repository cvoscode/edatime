{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "edatime HTTP API contract",
  "version": "v1",
  "basePath": "/api/v1",
  "headers": {
    "requestId": "x-request-id",
    "requestIdCallerPolicy": "A caller-supplied ID is accepted only when it is 1-128 ASCII letters, digits, dot, underscore, or hyphen; otherwise the server replaces it.",
    "buildVersion": "x-edatime-build",
    "buildCommit": "x-edatime-build-sha",
    "buildProfile": "x-edatime-build-profile",
    "contractVersion": "x-edatime-contract"
  },
  "error": {
    "contentType": "application/json",
    "required": ["error", "message", "kind", "code", "correlation_id", "request_id"]
  },
  "schemas": {
    "CleaningPlanEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "expectedSourceVersionId", "expectedDatasetRevision"],
      "properties": {
        "plan": { "type": "object", "additionalProperties": true },
        "expectedPlanHash": { "type": ["string", "null"] },
        "expectedSourceVersionId": { "type": "string", "minLength": 1 },
        "expectedDatasetRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "DataRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "width", "cleaning_plan"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "width": { "type": "integer", "minimum": 1 },
        "columns": { "type": ["string", "null"] },
        "color_column": { "type": ["string", "null"] },
        "lookaround_ms": { "type": ["integer", "null"], "minimum": 0 },
        "format": { "type": ["string", "null"], "enum": ["arrow", "json", null] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "ScatterPointsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "cleaning_plan"],
      "properties": {
        "x": { "type": "string", "minLength": 1 },
        "y": { "type": "string", "minLength": 1 },
        "color": { "type": ["string", "null"] },
        "size": { "type": ["string", "null"] },
        "start": { "type": ["number", "null"] },
        "end": { "type": ["number", "null"] },
        "limit": { "type": "integer", "minimum": 0, "description": "Zero or omission selects the configured default; positive values are clamped to the server limit." },
        "format": { "type": ["string", "null"], "enum": ["arrow", "json", null] },
        "time_color_mode": { "type": ["string", "null"], "enum": ["bucket", "raw", null] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "CausalGraphRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleaning_plan"],
      "properties": {
        "columns": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "tau_max": { "type": "integer", "minimum": 1, "maximum": 128 },
        "pc_alpha": { "type": "number", "description": "Finite values are accepted and clamped to the server-supported range." },
        "alpha": { "type": "number", "description": "Finite values are accepted and clamped to the server-supported range." },
        "method": { "type": "string", "enum": ["pcmci", "pcmciplus", "fullci", "bivci", "lpcmci"] },
        "test": { "type": "string", "enum": ["par_corr", "cmi_knn", "robust_parcorr", "gsquared", "cmi_symb"] },
        "max_points": { "type": "integer", "minimum": 1 },
        "max_conds_dim": { "type": "integer", "minimum": 0 },
        "fdr_method": { "type": "string", "enum": ["none", "fdr_bh"] },
        "n_preliminary_iterations": { "type": "integer", "minimum": 0 },
        "knn": { "type": "integer", "minimum": 1 },
        "sig_samples": { "type": "integer", "minimum": 1 },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "RollingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "cleaning_plan"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "columns": { "type": ["string", "null"] },
        "window": { "type": ["integer", "null"], "minimum": 0, "description": "Omission selects the default; the service clamps accepted values." },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "AnomalyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "cleaning_plan"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "columns": { "type": ["string", "null"] },
        "method": { "type": ["string", "null"], "enum": ["zscore", "iqr", null] },
        "threshold": { "type": ["number", "null"] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "FftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "cleaning_plan"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "columns": { "type": ["string", "null"] },
        "max_points": { "type": ["integer", "null"], "minimum": 64 },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "SpectrogramRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "column", "cleaning_plan"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "column": { "type": "string", "minLength": 1 },
        "window_size": { "type": ["integer", "null"], "minimum": 0, "description": "The service clamps values to its supported window range." },
        "hop_size": { "type": ["integer", "null"], "minimum": 0, "description": "The service clamps values to the resolved window size." },
        "max_points": { "type": ["integer", "null"], "minimum": 256 },
        "normalize": { "type": ["string", "null"], "enum": ["none", "minmax", "min-max", "min_max", "zscore", "z-score", "z_score", "robust", null] },
        "clip": { "type": ["string", "null"], "enum": ["none", "percentile", "pct", "p", "iqr", null] },
        "clip_param": { "type": ["number", "null"] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "SpectralFilterRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "filter_type", "cleaning_plan"],
      "properties": {
        "start": { "type": ["string", "null"], "format": "date-time" },
        "end": { "type": ["string", "null"], "format": "date-time" },
        "column": { "type": "string", "minLength": 1 },
        "filter_type": { "type": "string", "enum": ["lowpass", "highpass", "bandpass", "bandstop"] },
        "low_hz": { "type": ["number", "null"], "minimum": 0 },
        "high_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "sample_rate_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "max_points": { "type": ["integer", "null"], "minimum": 64 },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      },
      "allOf": [
        { "if": { "properties": { "filter_type": { "const": "lowpass" } } }, "then": { "required": ["high_hz"] } },
        { "if": { "properties": { "filter_type": { "const": "highpass" } } }, "then": { "required": ["low_hz"] } },
        { "if": { "properties": { "filter_type": { "enum": ["bandpass", "bandstop"] } } }, "then": { "required": ["low_hz", "high_hz"] } }
      ]
    },
    "CleaningDataExportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "expectedSourceVersionId", "expectedDatasetRevision"],
      "properties": {
        "plan": { "type": "object", "additionalProperties": true },
        "expectedPlanHash": { "type": ["string", "null"] },
        "expectedSourceVersionId": { "type": "string", "minLength": 1 },
        "expectedDatasetRevision": { "type": "integer", "minimum": 0 },
        "format": { "type": "string", "enum": ["parquet"] },
        "outputColumns": { "type": ["array", "null"], "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "CleaningCodeExportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "expectedSourceVersionId", "expectedDatasetRevision", "language"],
      "properties": {
        "plan": { "type": "object", "additionalProperties": true },
        "expectedPlanHash": { "type": ["string", "null"] },
        "expectedSourceVersionId": { "type": "string", "minLength": 1 },
        "expectedDatasetRevision": { "type": "integer", "minimum": 0 },
        "language": { "type": "string", "enum": ["python", "rust"] }
      }
    },
    "OutlierProposalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "expectedSourceVersionId", "expectedDatasetRevision", "columns", "method", "threshold"],
      "properties": {
        "plan": { "type": "object", "additionalProperties": true },
        "expectedPlanHash": { "type": ["string", "null"] },
        "expectedSourceVersionId": { "type": "string", "minLength": 1 },
        "expectedDatasetRevision": { "type": "integer", "minimum": 0 },
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "method": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number" }
      }
    },
    "SelectVersionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionId"],
      "properties": { "versionId": { "type": "string", "minLength": 1 } }
    },
    "ScatterMatrixRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairs", "cleaning_plan"],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "string", "minLength": 1 },
              "y": { "type": "string", "minLength": 1 }
            }
          }
        },
        "color": { "type": ["string", "null"] },
        "start": { "type": ["number", "null"] },
        "end": { "type": ["number", "null"] },
        "time_color_mode": { "type": ["string", "null"], "enum": ["bucket", "raw", null] },
        "limit": { "type": "integer", "minimum": 0, "description": "Zero or omission selects the configured default." },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "ScatterCorrelationsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleaning_plan"],
      "properties": {
        "base": { "type": ["string", "null"] },
        "threshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "mode": { "type": ["string", "null"], "enum": ["pearson_raw", "spearman_raw", "kendall_raw", "pearson_diff", "spearman_diff", "kendall_diff", null] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "CorrelationMatrixRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleaning_plan"],
      "properties": {
        "mode": { "type": ["string", "null"], "enum": ["pearson_raw", "spearman_raw", "kendall_raw", "pearson_diff", "spearman_diff", "kendall_diff", null] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "DriftStatsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "window", "referenceStart", "referenceEnd", "cleaningPlan"],
      "properties": {
        "column": { "type": "string", "minLength": 1 },
        "window": { "type": "string", "enum": ["hourly", "daily", "weekly"] },
        "referenceStart": { "type": "string", "minLength": 1 },
        "referenceEnd": { "type": "string", "minLength": 1 },
        "ksPvalueThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "esPvalueThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "psiMinorThreshold": { "type": "number", "minimum": 0 },
        "psiMajorThreshold": { "type": "number", "minimum": 0 },
        "wassersteinStdMultiplier": { "type": "number", "minimum": 0 },
        "cleaningPlan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "DriftInvestigateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "window", "referenceStart", "referenceEnd", "cleaningPlan"],
      "properties": {
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "window": { "type": "string", "enum": ["hourly", "daily", "weekly"] },
        "referenceStart": { "type": "string", "minLength": 1 },
        "referenceEnd": { "type": "string", "minLength": 1 },
        "comparisonStart": { "type": "string", "minLength": 1 },
        "comparisonEnd": { "type": "string", "minLength": 1 },
        "segmentBy": { "type": "string", "minLength": 1 },
        "segmentLimit": { "type": "integer", "minimum": 1 },
        "ksPvalueThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "esPvalueThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "psiMinorThreshold": { "type": "number", "minimum": 0 },
        "psiMajorThreshold": { "type": "number", "minimum": 0 },
        "wassersteinStdMultiplier": { "type": "number", "minimum": 0 },
        "includeQuality": { "type": "boolean" },
        "includeChangePoints": { "type": "boolean" },
        "includeCorrelations": { "type": "boolean" },
        "cleaningPlan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    }
  },
  "operations": [
    {"method":"GET","path":"/api/v1/health","response":"HealthResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/build","response":"BuildIdentity","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/contract","response":"ApiContract","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/capabilities","response":"Capabilities","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/data","request":"DataRequest","response":"ArrowData|JsonData","contentType":"application/vnd.apache.arrow.stream|application/json","planAware":true},
    {"method":"POST","path":"/api/v1/cleaning/validate","request":"CleaningPlanEnvelope","response":"ValidationResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/preview","request":"CleaningPlanEnvelope","response":"CleaningPreviewResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/propose/outliers","request":"OutlierProposalRequest","response":"OutlierProposalResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/apply","request":"CleaningPlanEnvelope","response":"CleaningApplyResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/export/data","request":"CleaningDataExportRequest","response":"File","contentType":"application/octet-stream"},
    {"method":"POST","path":"/api/v1/cleaning/export/plan","request":"CleaningPlanEnvelope","response":"File","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/export/code","request":"CleaningCodeExportRequest","response":"File","contentType":"text/plain"},
    {"method":"POST","path":"/api/v1/cleaning/export/manifest","request":"CleaningPlanEnvelope","response":"File","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/cleaning/export/bundle","request":"CleaningPlanEnvelope","response":"File","contentType":"application/zip"},
    {"method":"GET","path":"/api/v1/datasets/versions","response":"DatasetVersionsResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/datasets/versions/select","request":"SelectVersionRequest","response":"SelectVersionResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/datasets/storage","response":"StorageUsageResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/metadata","response":"DatasetMetadata","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/profile","response":"ProfileResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/profile","response":"ProfileResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/profile/sample","response":"ProfileResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/profile/sample","response":"ProfileResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/metrics","response":"MetricsResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/metrics/prometheus","response":"PrometheusMetrics","contentType":"text/plain"},
    {"method":"GET","path":"/api/v1/jobs","response":"JobListResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/jobs/{id}","response":"JobResponse","contentType":"application/json"},
    {"method":"DELETE","path":"/api/v1/jobs/{id}","response":"JobResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/scatter/points","request":"ScatterPointsRequest","response":"ScatterPointsResponse|ArrowData","contentType":"application/json|application/vnd.apache.arrow.stream","planAware":true},
    {"method":"POST","path":"/api/v1/scatter/matrix","request":"ScatterMatrixRequest","response":"ScatterMatrixResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/scatter/export/parquet","request":"ScatterExportRequest","response":"File","contentType":"application/vnd.apache.parquet","planAware":true},
    {"method":"POST","path":"/api/v1/scatter/correlations","request":"ScatterCorrelationsRequest","response":"ScatterCorrelationsResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/scatter/correlations/matrix","request":"CorrelationMatrixRequest","response":"CorrelationMatrixResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/upload","request":"MultipartUpload","response":"UploadResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/upload/preview","request":"MultipartUpload","response":"UploadPreviewResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/sample/{name}","response":"File","contentType":"text/csv"},
    {"method":"POST","path":"/api/v1/database/connect","request":"DatabaseConnectRequest","response":"DatabaseStatusResponse","contentType":"application/json"},
    {"method":"DELETE","path":"/api/v1/database/connect","response":"DatabaseStatusResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/database/status","response":"DatabaseStatusResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/database/tables","response":"DatabaseTablesResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/database/columns","response":"DatabaseColumnsResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/database/load","request":"DatabaseLoadRequest","response":"UploadResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/config/database","response":"DatabaseConfigResponse","contentType":"application/json"},
    {"method":"GET","path":"/api/v1/aggregate","request":"AggregateQuery","response":"AggregateResponse","contentType":"application/json"},
    {"method":"POST","path":"/api/v1/analytics/rolling","request":"RollingRequest","response":"RollingResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/analytics/anomalies","request":"AnomalyRequest","response":"AnomalyResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/analytics/fft","request":"FftRequest","response":"FftResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/analytics/spectrogram","request":"SpectrogramRequest","response":"SpectrogramResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/analytics/spectral-filter","request":"SpectralFilterRequest","response":"SpectralFilterResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/analytics/causal","request":"CausalGraphRequest","response":"CausalGraphResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/drift/stats","request":"DriftStatsRequest","response":"DriftStatsResponse","contentType":"application/json","planAware":true},
    {"method":"POST","path":"/api/v1/drift/investigate","request":"DriftInvestigateRequest","response":"DriftInvestigateResponse","contentType":"application/json","planAware":true}
  ]
}
