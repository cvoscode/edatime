{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "edatime HTTP API contract",
  "version": "v1",
  "basePath": "/api/v1",
  "headers": {
    "requestId": "x-request-id",
    "requestIdCallerPolicy": "A caller-supplied ID is accepted only when it is 1-128 ASCII letters, digits, dot, underscore, or hyphen; otherwise the server replaces it.",
    "buildVersion": "x-edatime-build",
    "buildCommit": "x-edatime-build-sha",
    "buildProfile": "x-edatime-build-profile",
    "contractVersion": "x-edatime-contract"
  },
  "error": {
    "contentType": "application/json",
    "required": ["error", "message", "kind", "code", "correlation_id", "request_id"]
  },
  "schemas": {
    "HealthResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["status"], "properties": { "status": { "const": "ok" } }
    },
    "BuildIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "version", "git_sha", "profile", "contract_version"],
      "properties": {
        "package": { "type": "string" }, "version": { "type": "string" },
        "git_sha": { "type": "string" }, "profile": { "type": "string" },
        "contract_version": { "type": "string", "const": "v1" }
      }
    },
    "CleaningPlanEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "expectedSourceVersionId", "expectedDatasetRevision"],
      "properties": {
        "plan": { "type": "object", "additionalProperties": true },
        "expectedPlanHash": { "type": ["string", "null"] },
        "expectedSourceVersionId": { "type": "string", "minLength": 1 },
        "expectedDatasetRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "DataRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "width", "cleaning_plan"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "width": { "type": "integer", "minimum": 1 },
        "columns": { "type": ["string", "null"] },
        "color_column": { "type": ["string", "null"] },
        "lookaround_ms": { "type": ["integer", "null"], "minimum": 0 },
        "format": { "type": ["string", "null"], "enum": ["arrow", "json", null] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "ScatterPointsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "cleaning_plan"],
      "properties": {
        "x": { "type": "string", "minLength": 1 },
        "y": { "type": "string", "minLength": 1 },
        "color": { "type": ["string", "null"] },
        "size": { "type": ["string", "null"] },
        "start": { "type": ["number", "null"] },
        "end": { "type": ["number", "null"] },
        "limit": { "type": "integer", "minimum": 0, "description": "Zero or omission selects the configured default; positive values are clamped to the server limit." },
        "format": { "type": ["string", "null"], "enum": ["arrow", "json", null] },
        "time_color_mode": { "type": ["string", "null"], "enum": ["bucket", "raw", null] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "CausalGraphRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleaning_plan"
      ],
      "properties": {
        "columns": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "tau_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "pc_alpha": {
          "type": "number",
          "description": "Finite values are accepted and clamped to the server-supported range."
        },
        "alpha": {
          "type": "number",
          "description": "Finite values are accepted and clamped to the server-supported range."
        },
        "method": {
          "type": "string",
          "enum": [
            "pcmci",
            "pcmciplus",
            "fullci",
            "bivci",
            "lpcmci"
          ]
        },
        "test": {
          "type": "string",
          "enum": [
            "par_corr",
            "cmi_knn",
            "robust_parcorr",
            "gsquared",
            "cmi_symb"
          ]
        },
        "max_points": {
          "type": "integer",
          "minimum": 1
        },
        "max_conds_dim": {
          "type": "integer",
          "minimum": 0
        },
        "fdr_method": {
          "type": "string",
          "enum": [
            "none",
            "fdr_bh"
          ]
        },
        "n_preliminary_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "knn": {
          "type": "integer",
          "minimum": 1
        },
        "sig_samples": {
          "type": "integer",
          "minimum": 1
        },
        "cleaning_plan": {
          "$ref": "#/components/schemas/CleaningPlanEnvelope"
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "RollingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "cleaning_plan"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "columns": { "type": ["string", "null"] },
        "window": { "type": ["integer", "null"], "minimum": 0, "description": "Omission selects the default; the service clamps accepted values." },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "AnomalyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "cleaning_plan"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "columns": { "type": ["string", "null"] },
        "method": { "type": ["string", "null"], "enum": ["zscore", "iqr", null] },
        "threshold": { "type": ["number", "null"] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "FftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "cleaning_plan"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "columns": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_points": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 64
        },
        "cleaning_plan": {
          "$ref": "#/components/schemas/CleaningPlanEnvelope"
        },
        "detrend": {
          "type": "string",
          "enum": [
            "none",
            "constant",
            "linear"
          ],
          "default": "constant"
        }
      }
    },
    "SpectrogramRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "column", "cleaning_plan"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "column": { "type": "string", "minLength": 1 },
        "window_size": { "type": ["integer", "null"], "minimum": 0, "description": "The service clamps values to its supported window range." },
        "hop_size": { "type": ["integer", "null"], "minimum": 0, "description": "The service clamps values to the resolved window size." },
        "max_points": { "type": ["integer", "null"], "minimum": 256 },
        "normalize": { "type": ["string", "null"], "enum": ["none", "minmax", "min-max", "min_max", "zscore", "z-score", "z_score", "robust", null] },
        "clip": { "type": ["string", "null"], "enum": ["none", "percentile", "pct", "p", "iqr", null] },
        "clip_param": { "type": ["number", "null"] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "SpectralFilterRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "filter_type", "cleaning_plan"],
      "properties": {
        "start": { "type": ["string", "null"], "format": "date-time" },
        "end": { "type": ["string", "null"], "format": "date-time" },
        "column": { "type": "string", "minLength": 1 },
        "filter_type": { "type": "string", "enum": ["lowpass", "highpass", "bandpass", "bandstop"] },
        "low_hz": { "type": ["number", "null"], "minimum": 0 },
        "high_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "sample_rate_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "max_points": { "type": ["integer", "null"], "minimum": 64 },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      },
      "allOf": [
        { "if": { "properties": { "filter_type": { "const": "lowpass" } } }, "then": { "required": ["high_hz"] } },
        { "if": { "properties": { "filter_type": { "const": "highpass" } } }, "then": { "required": ["low_hz"] } },
        { "if": { "properties": { "filter_type": { "enum": ["bandpass", "bandstop"] } } }, "then": { "required": ["low_hz", "high_hz"] } }
      ]
    },
    "CleaningDataExportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "expectedSourceVersionId", "expectedDatasetRevision"],
      "properties": {
        "plan": { "type": "object", "additionalProperties": true },
        "expectedPlanHash": { "type": ["string", "null"] },
        "expectedSourceVersionId": { "type": "string", "minLength": 1 },
        "expectedDatasetRevision": { "type": "integer", "minimum": 0 },
        "format": { "type": "string", "enum": ["parquet"] },
        "outputColumns": { "type": ["array", "null"], "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "CleaningCodeExportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "expectedSourceVersionId", "expectedDatasetRevision", "language"],
      "properties": {
        "plan": { "type": "object", "additionalProperties": true },
        "expectedPlanHash": { "type": ["string", "null"] },
        "expectedSourceVersionId": { "type": "string", "minLength": 1 },
        "expectedDatasetRevision": { "type": "integer", "minimum": 0 },
        "language": { "type": "string", "enum": ["python", "rust"] }
      }
    },
    "OutlierProposalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "expectedSourceVersionId", "expectedDatasetRevision", "columns", "method", "threshold"],
      "properties": {
        "plan": { "type": "object", "additionalProperties": true },
        "expectedPlanHash": { "type": ["string", "null"] },
        "expectedSourceVersionId": { "type": "string", "minLength": 1 },
        "expectedDatasetRevision": { "type": "integer", "minimum": 0 },
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "method": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number" }
      }
    },
    "SelectVersionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionId"],
      "properties": { "versionId": { "type": "string", "minLength": 1 } }
    },
    "ScatterMatrixRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairs", "cleaning_plan"],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "string", "minLength": 1 },
              "y": { "type": "string", "minLength": 1 }
            }
          }
        },
        "color": { "type": ["string", "null"] },
        "start": { "type": ["number", "null"] },
        "end": { "type": ["number", "null"] },
        "time_color_mode": { "type": ["string", "null"], "enum": ["bucket", "raw", null] },
        "limit": { "type": "integer", "minimum": 0, "description": "Zero or omission selects the configured default." },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "ScatterCorrelationsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleaning_plan"],
      "properties": {
        "base": { "type": ["string", "null"] },
        "threshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "mode": { "type": ["string", "null"], "enum": ["pearson_raw", "spearman_raw", "kendall_raw", "pearson_diff", "spearman_diff", "kendall_diff", null] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "CorrelationMatrixRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleaning_plan"],
      "properties": {
        "mode": { "type": ["string", "null"], "enum": ["pearson_raw", "spearman_raw", "kendall_raw", "pearson_diff", "spearman_diff", "kendall_diff", null] },
        "cleaning_plan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "DatabaseConnectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_string"],
      "properties": {
        "connection_string": { "type": "string", "minLength": 1, "pattern": "^postgres(ql)?://" },
        "schema": { "type": "string", "minLength": 1, "default": "public" },
        "table": { "type": ["string", "null"], "minLength": 1 },
        "time_column": { "type": ["string", "null"], "minLength": 1 },
        "load_snapshot": { "type": "boolean", "default": false },
        "snapshot_limit": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "DatabaseLoadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table"],
      "properties": {
        "schema": { "type": "string", "minLength": 1, "default": "public" },
        "table": { "type": "string", "minLength": 1 },
        "time_column": { "type": ["string", "null"], "minLength": 1 },
        "columns": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
        "limit": { "type": ["integer", "null"], "minimum": 0 },
        "start_ms": { "type": ["integer", "null"] },
        "end_ms": { "type": ["integer", "null"] }
      }
    },
    "DatabaseColumnsQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table"],
      "properties": {
        "schema": { "type": "string", "minLength": 1, "default": "public" },
        "table": { "type": "string", "minLength": 1 }
      }
    },
    "AggregateQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "columns": { "type": ["string", "null"] },
        "buckets": { "type": "integer", "minimum": 1, "default": 50 },
        "window_mode": { "type": "string", "enum": ["buckets", "tumbling", "sliding"], "default": "buckets" },
        "window_ms": { "type": ["integer", "null"], "minimum": 1 },
        "step_ms": { "type": ["integer", "null"], "minimum": 1 },
        "agg": { "type": "string", "enum": ["mean", "sum", "min", "max", "count"], "default": "mean" },
        "format": { "type": ["string", "null"], "enum": ["arrow", "json", null] }
      }
    },
    "DriftStatsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "window", "referenceStart", "referenceEnd", "cleaningPlan"],
      "properties": {
        "column": { "type": "string", "minLength": 1 },
        "window": { "type": "string", "enum": ["hourly", "daily", "weekly"] },
        "referenceStart": { "type": "string", "minLength": 1 },
        "referenceEnd": { "type": "string", "minLength": 1 },
        "ksPvalueThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "esPvalueThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "psiMinorThreshold": { "type": "number", "minimum": 0 },
        "psiMajorThreshold": { "type": "number", "minimum": 0 },
        "wassersteinStdMultiplier": { "type": "number", "minimum": 0 },
        "cleaningPlan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "DriftInvestigateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "window", "referenceStart", "referenceEnd", "cleaningPlan"],
      "properties": {
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "window": { "type": "string", "enum": ["hourly", "daily", "weekly"] },
        "referenceStart": { "type": "string", "minLength": 1 },
        "referenceEnd": { "type": "string", "minLength": 1 },
        "comparisonStart": { "type": "string", "minLength": 1 },
        "comparisonEnd": { "type": "string", "minLength": 1 },
        "segmentBy": { "type": "string", "minLength": 1 },
        "segmentLimit": { "type": "integer", "minimum": 1 },
        "ksPvalueThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "esPvalueThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "psiMinorThreshold": { "type": "number", "minimum": 0 },
        "psiMajorThreshold": { "type": "number", "minimum": 0 },
        "wassersteinStdMultiplier": { "type": "number", "minimum": 0 },
        "includeQuality": { "type": "boolean" },
        "includeChangePoints": { "type": "boolean" },
        "includeCorrelations": { "type": "boolean" },
        "cleaningPlan": { "$ref": "#/components/schemas/CleaningPlanEnvelope" }
      }
    },
    "DatasetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "profile_status",
        "total_rows",
        "columns",
        "numeric_columns",
        "time_column",
        "time_range",
        "column_profiles"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "source_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_version_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "root_source_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_source_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_status": {
          "type": "string"
        },
        "profile_sample_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ColumnMetadata"
          }
        },
        "numeric_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_range": {
          "oneOf": [
            {
              "$ref": "#/components/schemas/TimeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_quality": {
          "type": [
            "object",
            "null"
          ]
        },
        "column_profiles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "profile_sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "source_rows",
            "sampled_rows",
            "seed"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "source_rows": {
              "type": "integer"
            },
            "sampled_rows": {
              "type": "integer"
            },
            "seed": {
              "type": "integer"
            }
          }
        }
      }
    },
    "ColumnMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "dtype"],
      "properties": { "name": { "type": "string" }, "dtype": { "type": "string" } }
    },
    "TimeRange": {
      "type": "object", "additionalProperties": false,
      "required": ["min", "max"],
      "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }
    },
    "ScatterPointsResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "total_points", "returned_points", "points"],
      "properties": {
        "x": { "type": "string" }, "y": { "type": "string" },
        "color": { "type": ["string", "null"] },
        "total_points": { "type": "integer", "minimum": 0 },
        "returned_points": { "type": "integer", "minimum": 0 },
        "points": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 } },
        "color_values": { "type": ["array", "null"], "items": { "type": "number" } },
        "color_labels": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
        "color_min": { "type": ["number", "null"] }, "color_max": { "type": ["number", "null"] },
        "size_values": { "type": ["array", "null"], "items": { "type": "number" } },
        "size_min": { "type": ["number", "null"] }, "size_max": { "type": ["number", "null"] },
        "color_cardinality": { "type": ["object", "null"] }
      }
    },
    "UploadResponse": {
      "type": "object", "additionalProperties": true,
      "required": ["metadata"],
      "properties": { "metadata": { "$ref": "#/components/schemas/DatasetMetadata" } }
    },
    "CausalGraphResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph",
        "val_matrix",
        "p_matrix",
        "columns",
        "tau_max",
        "links"
      ],
      "properties": {
        "graph": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "val_matrix": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "p_matrix": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tau_max": {
