{
  "private": true,
  "type": "module",
  "scripts": {
    "check:frontend": "tsc --noEmit -p tsconfig.json",
    "check:frontend:arch": "node scripts/check-frontend-architecture.mjs",
    "check:frontend:reachability": "node scripts/check-frontend-reachability.mjs",
    "check:frontend:budgets": "node scripts/check-frontend-budgets.mjs",
    "check:frontend:assets": "node scripts/check-frontend-asset-graph.mjs",
    "generate:api-contract": "node scripts/generate_api_contract_types.mjs",
    "check:api-contract": "node scripts/generate_api_contract_types.mjs --check && node scripts/check_api_contract.mjs",
    "check:api-docs": "node scripts/generate_api_reference.mjs --check",
    "check:backend-hygiene": "node scripts/check_backend_hygiene.mjs",
    "check:repo-hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:frontend:all": "npm run check:frontend && npm run check:frontend:arch && npm run check:frontend:reachability && npm run check:frontend:budgets && npm run check:frontend:assets",
    "validate": "npm run check:frontend:all",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite --config frontend/vite.config.ts",
    "dev:full": "node scripts/dev.mjs",
    "build": "node scripts/build-frontend.mjs",
    "build:prod": "node scripts/build-frontend.mjs --prod",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build:frontend:prod": "node scripts/build-frontend.mjs --prod",
    "watch:frontend": "node scripts/build-frontend.mjs --watch",
    "preview": "vite preview --config frontend/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "npm run build:prod && playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench:app:artifacts": "node scripts/bench_app_structure.mjs artifacts",
    "bench:workspace": "vitest bench frontend/src/workspace/workspaceStore.bench.ts"
  },
  "dependencies": {
    "chartgpu": "file:frontend/libs/chartgpu"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@solidjs/router": "^0.15.4",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.4",
    "apache-arrow": "^16.1.0",
    "babel-preset-solid": "^1.9.12",
    "echarts": "^5.6.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.9.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.8.0",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.7"
  }
}
