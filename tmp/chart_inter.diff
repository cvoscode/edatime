+export interface WheelZoomViewportOptions {
+    container: HTMLElement;
+    grid: GridLayout;
+    getXRange: () => { min: number; max: number };
+    getYRange: () => { min: number; max: number };
+    onZoom: (view: { xMin: number; xMax: number; yMin: number; yMax: number }) => void;
+    /** Optional per-axis clamps; default keeps the view inside the data range. */
+    clampX?: { min: number; max: number };
+    clampY?: { min: number; max: number };
+    /** Disable the listener while a drawing / box-zoom drag is in progress. */
+    shouldIgnore?: (e: WheelEvent) => boolean;
+    /** Zoom in / zoom out factors; defaults match the timeseries docs. */
+    zoomInFactor?: number;
+    zoomOutFactor?: number;
+}
+
+/**
+ * Wire scroll-wheel zoom on a 2D viewport (scatter / density). The focal
+ * point is computed in plot-area normalized coordinates and the same
+ * factor is applied to both axes so aspect ratio is preserved.
+ */
+export function initWheelZoomViewport(opts: WheelZoomViewportOptions): void {
+    const {
+        container, grid, getXRange, getYRange, onZoom,
+        clampX, clampY, shouldIgnore,
+        zoomInFactor = 1.25, zoomOutFactor = 0.8,
+    } = opts;
+
+    container.addEventListener('wheel', (e) => {
+        if (shouldIgnore?.(e)) return;
+        // Wheel events inside input controls should be left alone so users
+        // can still scroll long dropdowns/selects overlaid on the chart.
+        const target = e.target as HTMLElement | null;
+        if (target && target.closest('input, select, textarea, button, [contenteditable="true"]')) return;
+
+        e.preventDefault();
+        const rect = container.getBoundingClientRect();
+        const plotL = grid.left;
+        const plotT = grid.top;
+        const plotW = Math.max(1, rect.width - grid.left - grid.right);
+        const plotH = Math.max(1, rect.height - grid.top - grid.bottom);
+        const xNorm = Math.max(0, Math.min(1, (e.clientX - rect.left - plotL) / plotW));
+        const yNorm = Math.max(0, Math.min(1, 1 - (e.clientY - rect.top - plotT) / plotH));
+
+        const { min: xCurMin, max: xCurMax } = getXRange();
+        const { min: yCurMin, max: yCurMax } = getYRange();
+        const xRange = xCurMax - xCurMin;
+        const yRange = yCurMax - yCurMin;
+        if (!(xRange > 0) || !(yRange > 0)) return;
+
+        const xFocus = xCurMin + xNorm * xRange;
+        const yFocus = yCurMin + yNorm * yRange;
+        // deltaY > 0 means scrolling down → zoom out (range grows).
+        const factor = e.deltaY > 0 ? zoomInFactor : zoomOutFactor;
+
+        let newXRange = xRange * factor;
+        let newYRange = yRange * factor;
+        // Guard against underflow when repeatedly zooming in on a tiny range.
+        const minRange = 1e-9;
+        if (newXRange < minRange) newXRange = minRange;
+        if (newYRange < minRange) newYRange = minRange;
+
+        let newXMin = xFocus - xNorm * newXRange;
+        let newXMax = newXMin + newXRange;
+        let newYMin = yFocus - yNorm * newYRange;
+        let newYMax = newYMin + newYRange;
+
+        if (clampX) {
+            // Clamp horizontally without losing the focal point when possible.
+            if (newXMax - newXMin > clampX.max - clampX.min) {
+                newXMin = clampX.min;
+                newXMax = clampX.max;
+            } else {
+                if (newXMin < clampX.min) { newXMax += (clampX.min - newXMin); newXMin = clampX.min; }
+                if (newXMax > clampX.max) { newXMin -= (newXMax - clampX.max); newXMax = clampX.max; }
+            }
+        }
+        if (clampY) {
+            if (newYMax - newYMin > clampY.max - clampY.min) {
+                newYMin = clampY.min;
+                newYMax = clampY.max;
+            } else {
+                if (newYMin < clampY.min) { newYMax += (clampY.min - newYMin); newYMin = clampY.min; }
+                if (newYMax > clampY.max) { newYMin -= (newYMax - clampY.max); newYMax = clampY.max; }
+            }
+        }
+
+        if (newXMax > newXMin + 1e-30 && newYMax > newYMin + 1e-30) {
+            onZoom({ xMin: newXMin, xMax: newXMax, yMin: newYMin, yMax: newYMax });
+        }
+    }, { passive: false });
+}
