+function scheduleRenderScatter(opts: { preserveView?: boolean } = {}): void {
+    if (!_scheduleRender) {
+        // Use a global helper attached by scatterPage.ts at module load.
+        type ScheduleHelper = { __scatterScheduleRender?: (opts?: { preserveView?: boolean }) => void };
